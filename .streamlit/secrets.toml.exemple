# Copie ce contenu dans les « Secrets » de ton app sur Streamlit Community Cloud
# (Settings → Secrets). Ne commite JAMAIS le vrai fichier secrets.toml.

[github]
repo = "marekdoucet/pool-survivor"
token = "github_pat_..."   # jeton « fine-grained » : Contents en lecture/écriture, ce dépôt seulement
branch = "main"

# Connexion Google. Sans cette section, l'app tourne sans connexion et laisse
# écrire : c'est le mode développement local. Dès qu'elle est présente, la
# lecture reste publique mais les écritures demandent un compte.
#
# Les identifiants viennent de console.cloud.google.com → APIs et services →
# Identifiants → ID client OAuth, type « Application Web ».
#
# redirect_uri doit être IDENTIQUE au caractère près à l'URI de redirection
# autorisé dans Google Cloud, sinon la connexion échoue sur
# « redirect_uri_mismatch ».
#
# cookie_secret se génère avec :
#     python -c "import secrets; print(secrets.token_hex(32))"
[auth]
redirect_uri = "https://pool-survivor-cheat-sheet.streamlit.app/oauth2callback"
cookie_secret = "..."
client_id = "....apps.googleusercontent.com"
client_secret = "GOCSPX-..."
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
